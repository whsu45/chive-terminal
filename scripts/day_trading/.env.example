# 複製成 .env 後填入（.env 已在 .gitignore，不會進 git）：
#   cp .env.example .env
# 永豐金證券 Shioaji API（https://sinotrade.github.io/）
SHIOAJI_API_KEY=
SHIOAJI_SECRET_KEY=
# 1 = 模擬環境（行情資料相同，不會下單）；0 = 正式環境
SHIOAJI_SIMULATION=1
# 大單/散戶門檻用「金額」不用張數：1 張台積電的錢可以買幾百張友達。
# 大單 = 單筆金額 >= BIG_LOT_AMOUNT（元），且不低於該股當日單筆張數的 95 分位
# 散戶 = 單筆金額 <  SMALL_LOT_AMOUNT（元），1 張單一律散戶；中間為中實戶不計入
# 以下為 2026/08/27~10/30 九檔逐筆校準值（python3 calibrate.py 可重算、--apply 可回寫）
BIG_LOT_AMOUNT=3000000
SMALL_LOT_AMOUNT=1000000
# 想固定用張數時才填（>0 會覆蓋上面的自動推算），平常留空
BIG_LOT_THRESHOLD=
# 校準多久算過舊（天）：monitor.py 啟動時若上次 calibrate 超過此天數，盤前/盤後立刻重跑，盤中則收盤後補跑
CALIBRATE_MAX_AGE_DAYS=45

# Windows 出現「Missing Subject Key Identifier」才設（只關 Python 3.13+ 的嚴格 X.509 檢查，憑證鏈與網域仍驗證；見 README「Windows」段）
# DAYTRADE_SSL_NOSTRICT=1
